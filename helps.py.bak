# ---------------------------
# Helper: Build a short memory summary from last N turns
# ---------------------------
def build_memory_summary(window: int = 5) -> str:
    hist = st.session_state.history[-window:] if st.session_state.history else []
    if not hist:
        return ""
    concat = []
    for t in hist:
        q = t.get("user", "")
        a = t.get("ai_answer", "")
        concat.append(f"Q: {q}\nA: {a}")
    text = "\n\n".join(concat)
    sm = summarize_with_type(text, st.session_state.llm_client, style="Small", model_choice=model_choice)
    return sm

# ---------------------------
# Format verification JSON into nice display
# ---------------------------
def format_verification_display(ver_text: str):
    # Accepts either valid JSON or 'Raw output (not valid JSON): <json-like>' or plain text
    if not ver_text:
        return None
    s = ver_text.strip()
    # Try direct JSON parse first
    try:
        data = json.loads(s)
    except Exception:
        # Try to extract JSON substring
        m = re.search(r'(\[.*\])', s, flags=re.S)
        if m:
            try:
                data = json.loads(m.group(1))
            except Exception:
                data = None
        else:
            data = None
    if isinstance(data, list):
        # Return rendered structure
        out_lines = []
        for i, item in enumerate(data, 1):
            claim = item.get("claim") if isinstance(item, dict) else str(item)
            refs = item.get("refs") if isinstance(item, dict) else []
            out_lines.append((claim, refs))
        return out_lines
    # fallback: return raw
    return s

